WorldInfo {
  info [
    "Demonstration du calculateur d'eclairage LSC (code C Embedded Coder) pilote par ROS 2 - Amina Borcheni"
  ]
  title "LSC - demonstration : virages, tunnel, ESS, nuit, maison"
  ERP 0.6
  basicTimeStep 10
  lineScale 1
  contactProperties [
    ContactProperties {
      coulombFriction [
        8
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
    ContactProperties {
      material2 "TeslaModel3Wheel"
      coulombFriction [
        8
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}
